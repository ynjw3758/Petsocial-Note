    		}
    	}
    	else {
    		logger.info("일부 삭제");
    		list=(List<Map<String, Object>>) param_data.get("List");
    		Map<String, Object> delete =new HashMap<String ,Object>();
    		if(param_data.get("Message").equals("receive")) {
    			logger.info("받은 쪽지 일부 삭재");
