    				logger.info("delete :" + delete);
        			note.selectRedelete(delete);
    			}
    		}
    		else {
    			logger.info("보낸 쪽지 일부 삭재");
    			for(int i=0; i<list.size(); i++) {
    				delete.put("Id", param_data.get("Id").toString());
    				delete.put("Noteid", list.get(i));
    				logger.info("delete :" + delete);
        			note.selectSedelete(delete);
    			}
    		}
    	}
    	
		data.put("resultcode", 200);
		data.put("resultmsg", "success");
		data.put("resultdata", "null");
    	
    	return data;
    }
	
