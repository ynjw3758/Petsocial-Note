			data.put("resultdata", "null");
		}

		}
		else {
			logger.info("보낸 쪽지 조회");
			send=note.GetSendNote(Id);
			if(send.size() !=0) {
			data.put("resultcode", 200);
			data.put("resultmsg", "success");
			data.put("resultdata", send);
			}
		else {
			data.put("resultcode", 200);
			data.put("resultmsg", "empty");
			data.put("resultdata", "null");
		}
		}
		
		return data;
	}
	
